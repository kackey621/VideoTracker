{{!
    @template mod_hlsplayer/player

    HLS Player template using Video.js.

    Context variables required for this template:
    * id - Unique player element ID
    * stream_url - URL of the HLS stream (.m3u8)
    * playback_rates - JSON array of allowed playback rates
    * allowseeking - Boolean: whether forward seeking is allowed
    * initial_progress - Maximum viewed time in seconds
    * initial_lastposition - Last playback position in seconds
    * hlsplayerid - The HLS player module instance ID

    Example context (json):
    {
        "id": "hls-player-abc123",
        "stream_url": "https://example.com/stream.m3u8",
        "playback_rates": "[0.5, 1, 1.5, 2]",
        "allowseeking": true,
        "initial_progress": 0,
        "initial_lastposition": 0,
        "hlsplayerid": 1
    }
}}
<div class="hlsplayer-container"
     data-player-id="{{id}}"
     data-hlsplayerid="{{hlsplayerid}}"
     data-initial-progress="{{initial_progress}}"
     data-initial-lastposition="{{initial_lastposition}}"
     data-allowseeking="{{#allowseeking}}1{{/allowseeking}}{{^allowseeking}}0{{/allowseeking}}"
     style="max-width: 800px; margin: 0 auto;">
    <video
        id="{{id}}"
        class="video-js vjs-default-skin vjs-big-play-centered"
        controls
        preload="auto"
        width="640"
        height="360"
        data-setup='{"playbackRates": {{playback_rates}} }'
        style="width: 100%; height: auto; aspect-ratio: 16/9;"
    >
        <source src="{{stream_url}}" type="application/x-mpegURL">
        <p class="vjs-no-js">
            To view this video please enable JavaScript, and consider upgrading to a web browser that
            <a href="https://videojs.com/html5-video-support/" target="_blank">supports HTML5 video</a>.
        </p>
    </video>
    <div class="hlsplayer-progress-display" style="margin-top: 10px; font-weight: bold;">
        {{#str}}yourprogress, mod_hlsplayer{{/str}}: <span id="progress-percentage-{{id}}">0</span>%
    </div>
</div>

{{#js}}
require(['mod_hlsplayer/player'], function(HlsPlayer) {
    HlsPlayer.init('{{id}}');
});
{{/js}}
